function previewSetData(setNumber) {

    const workout =
    WorkoutService.getWorkout(setNumber);

    if (!workout || workout.type !== "set") return;

    const {
    q1,
    q2,
    q4
} = getPreviewElements();

    updateQuadPreview(

    q1,

    [
        `🔥 NEXT: ${workout.core}`,
        `Reps: ${workout.reps}`,
        `Percentage: ${workout.percent}%`
    ]

);

    updateQuadPreview(

        q2,

        [
            `🔥 NEXT: ${workout.aux}`,
            `Reps: ${workout.auxReps}`
        ]

    );

    updateQuadPreview(

        q4,

        [
            `🔥 NEXT: ${workout.move}`,
            `Reps/Time: ${workout.moveReps}`
        ]

    );

}


