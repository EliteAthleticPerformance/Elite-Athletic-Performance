   GET NEXT SET INDEX (1-BASED)
====================================================== */

function getNextSetIndex() {

    // Start searching AFTER S.currentSet
    for (let i = S.currentSet; i < S.workoutData.length; i++) {
        if (S.workoutData[i].type === "set") {
            return i + 1; // convert to 1-based index
        }
    }

    // No more sets found
    return null;
}

/* ======================================================
   WORK DURATION (seconds)
====================================================== */

function getWorkDuration() {

    const currentItem = S.workoutData[S.currentSet - 1];

    // 1️⃣ per-set override
    if (currentItem?.workSec) {
        console.log("⏱ Work time (set override):", {
            set: S.currentSet,
            value: currentItem.workSec
        });
        return currentItem.workSec;
    }

    // 2️⃣ sheet global override
    if (S.sheetWorkDuration !== null) {
        console.log("⏱ Work time (sheet global):", S.sheetWorkDuration);
        return S.sheetWorkDuration;
    }

    // 3️⃣ UI fallback
    const val = parseInt(document.getElementById("workTime").value, 10);
    const safeVal = isNaN(val) || val <= 0 ? 1 : val;

    console.log("⏱ Work time (UI fallback):", safeVal);

    return safeVal;
}


/* ======================================================
   DETERMINISTIC QUADRANT ROTATION
====================================================== */

function applyRotationState(rotation) {

    const q1 = document.getElementById("q1");
    const q2 = document.getElementById("q2");
    const q3 = document.getElementById("q3");
    const q4 = document.getElementById("q4");

    if (!q1 || !q2 || !q3 || !q4) return;

    const base = {

        q1: {
            bg: "#000",
            color: "#fff"
        },

        q2: {
            bg: "#f4f4f4",
            color: "#000"
        },

        q3: {
            bg: "var(--primary)",
            color: "#fff"
        },

        q4: {
            bg: "#555",
            color: "#fff"
        }
    };

    const layouts = [

        // ROTATION 0
        {
            q1: base.q1,
            q2: base.q2,
            q3: base.q3,
            q4: base.q4
        },

        // ROTATION 1
        {
            q1: base.q3,
            q2: base.q1,
            q3: base.q4,
            q4: base.q2
        },

        // ROTATION 2
        {
            q1: base.q4,
            q2: base.q3,
            q3: base.q2,
            q4: base.q1
        },

        // ROTATION 3
        {
            q1: base.q2,
            q2: base.q4,
            q3: base.q1,
            q4: base.q3
        }
    ];

    const layout = layouts[rotation % 4];

    Object.keys(layout).forEach(id => {

        const el = document.getElementById(id);

        if (!el) return;

        el.style.background = layout[id].bg;
        el.style.color = layout[id].color;
    });
}


/* ======================================================
   REST DURATION (seconds)
====================================================== */

function getRestDuration() {

    // 1️⃣ per-set override
    const currentItem = S.workoutData[S.currentSet - 1];
    if (currentItem?.rotateSec) {
        console.log("⏱ Using per-set rotate:", currentItem.rotateSec);
        return currentItem.rotateSec;
    }

    // 2️⃣ sheet override
    if (S.sheetRotateDuration !== null) {
        console.log("⏱ Using sheet rotate:", S.sheetRotateDuration);
        return S.sheetRotateDuration;
    }

    // 3️⃣ UI fallback
    const val = parseInt(document.getElementById("restTime").value, 10);
    const safe = isNaN(val) || val <= 0 ? 1 : val;

    console.log("⏱ Using UI rotate:", safe);
    return safe;
}

function syncTime() {

    if (!S.isRunning) {

        const workVal = WorkoutService.getWorkDuration();
        const restVal = getRestDuration();

        S.timeLeft =
    (S.currentPhase === "work")
        ? workVal
        : restVal;

        refreshTimerUI();

        }
}

/* ======================================================
   RESET CENTER CLOCK
====================================================== */

function resetCenterClock() {

    const center = document.getElementById("center");

    center.classList.remove("workMode", "rotateMode");
    center.classList.add("workMode");

    document.getElementById("clock").innerText =
        document.getElementById("workTime").value;

    document.getElementById("phase").innerText = "WORK";
}


function buildWorkoutTimeline() {

    S.phaseSequence = [];
    S.phaseMeta = [];

    S.workoutData.forEach((item, index) => {

        /* =============================
           SET ROW
        ============================= */

        if (item.type === "set") {

            const nextItem = S.workoutData[index + 1];

            const isLastSetBeforeBreak =
                nextItem &&
                nextItem.type === "break";

            // ------------------------------------------------
            // 4 STATION ROTATIONS
            // ------------------------------------------------

            for (let station = 0; station < 4; station++) {

                /* ---------- WORK ---------- */

                S.phaseSequence.push("work");

               S.phaseMeta.push({
    phase: "work",
    setIndex: index + 1,
    station,
    rotation: station,
    duration:
        item.workSec ||
        S.sheetWorkDuration ||
        safeGet("workTime", 30)
});

 // ------------------------------------------------
 // FINAL STATION BEFORE BREAK
 // ------------------------------------------------

                const isFinalStation =
                    station === 3;

                if (
                    isLastSetBeforeBreak &&
                    isFinalStation
                ) {

                    // DO NOT ADD ROTATE
                    // Break will occur naturally next

                    continue;
                }

                /* ---------- ROTATE ---------- */

                S.phaseSequence.push("rotate");

                S.phaseMeta.push({
    phase: "rotate",
    setIndex: index + 1,
    station,
    rotation: station + 1,
    duration:
        item.rotateSec ||
        S.sheetRotateDuration ||
        safeGet("restTime", 30)
});
            }
        }

 /* =============================
    BREAK ROW
 ============================= */

        if (item.type === "break") {

           S.phaseSequence.push("break");

            S.phaseMeta.push({
                phase: "break",
                duration:
                    item.breakSec ||
                    breakDuration
            });
        }
    });

    console.log("🔥 PHASE SEQUENCE:", S.phaseSequence);
    console.log("🔥 TOTAL SEGMENTS:", S.phaseMeta.length);
}


